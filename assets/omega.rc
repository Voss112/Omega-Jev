// Template: build.rs fills the @...@ placeholders (version from Cargo.toml, absolute icon path).
1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @MAJOR@,@MINOR@,@PATCH@,0
PRODUCTVERSION @MAJOR@,@MINOR@,@PATCH@,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "Omega"
      VALUE "FileDescription", "Omega - agent IA local et anonyme"
      VALUE "FileVersion", "@VERSION@"
      VALUE "InternalName", "omega"
      VALUE "OriginalFilename", "omega.exe"
      VALUE "ProductName", "Omega"
      VALUE "ProductVersion", "@VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x40C, 1200
  END
END
